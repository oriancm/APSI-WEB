DOMAIN=apsi-btp.fr
ACME_EMAIL=contact@apsi-btp.fr

DB_NAME=apsi
DB_USER=apsi
DB_PASSWORD=
DB_ROOT_PASSWORD=

ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH_FILE=./secrets/admin-password-hash

# Leave SMTP_HOST empty on OVH shared hosting to use the hosting mail service.
# For an external SMTP service, set its host, credentials and sender below.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=info@apsi-btp.fr
SMTP_FROM_NAME=Formulaire de contact
# Contact requests are always delivered to info@apsi-btp.fr.

# Local demo only. Keep disabled in production; the online database is authoritative.
APSI_ALLOW_DEMO_DATA=0
